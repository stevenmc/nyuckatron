REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=newry-news-bot/1.0 by u/your-user-name

# Subreddit to post to, without the r/ prefix. Change this one line to
# point the whole bot at a different subreddit.
REDDIT_SUBREDDIT=newry

# Optional: Google Calendar sync for events (calendar_sync.py). Leave both
# blank to skip calendar sync entirely -- Reddit posting of events works
# either way. See README.md for how to create the service account and
# share a calendar with it.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=
